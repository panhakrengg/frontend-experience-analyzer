{
  "name": "@panhakreng/frontend-experience-analyzer",
  "version": "0.1.6",
  "description": "Comprehensive Frontend Experience, OWASP Security, WCAG 2.2 Accessibility, and Core Web Vitals Analyzer",
  "type": "module",
  "bin": {
    "fea": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:playwright && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@frontend-experience-analyzer/ai-advisor": "workspace:*",
    "@frontend-experience-analyzer/browser": "workspace:*",
    "@frontend-experience-analyzer/ci": "workspace:*",
    "@frontend-experience-analyzer/core": "workspace:*",
    "@frontend-experience-analyzer/framework-adapters": "workspace:*",
    "@frontend-experience-analyzer/plugin-system": "workspace:*",
    "@frontend-experience-analyzer/reporter": "workspace:*",
    "@frontend-experience-analyzer/rules": "workspace:*",
    "@frontend-experience-analyzer/rules-engine": "workspace:*",
    "esbuild": "^0.25.0"
  }
}
